{
  "name": "ideal-type-loading",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "USERS", "id": "b9d212d341c64a209a21b8fcdac418ce" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDO" },
      // 埋点单例（PRD-R9-PHASE1 §五）：全站一个实例，SQLite 原子累加
      { "name": "STATS", "class_name": "StatsDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO"] },
    { "tag": "v2", "new_sqlite_classes": ["StatsDO"] }
  ]
  // 仪表盘口令：生产执行 `wrangler secret put STATS_KEY`（未设置时 worker 回退到常量 "dev-stats"）
}
